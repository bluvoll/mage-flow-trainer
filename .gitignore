# Development environment, managed by uv against uv.lock.
.venv/
# What install.sh / install.bat produce. `venv/` is deliberately a different name from `.venv/`
# so an installed copy cannot take over the uv-managed one.
venv/
start-gui.sh
start-gui.bat
start-converter.sh
start-converter.bat

__pycache__/
*.pyc
*.egg-info/
build/

# Checkpoints, samples and per-run config copies.
output/
*.safetensors

# Your own configs stay local by default. To publish a chosen one:  git add -f configs/<name>.toml
configs/*.toml

# Reference checkout of Aozora Trainer. The GUI chrome is already vendored into `trainer/gui/`
# with attribution in NOTICE and trainer/gui/LICENSE.Aozora, so this copy is redundant, unimported
# and 169MB.
Aozora_Trainer/
# Not integrated (Phase 7 was never started) and carries its own .git, which would become a
# broken gitlink. Nothing under trainer/ imports it.
RamTorch/

# Working snapshots and third-party reference docs -- local only.
backups/
weight_dropout.pdf
high-frequency-token-loss.md

# Our working copy of the README, with real paths and dataset names.
Private-README.md

# Editor/tool state and caches.
.claude/
.ruff_cache/
.pytest_cache/
.mypy_cache/
.idea/
.vscode/

# Configs the paired-run pipeline generates from the form; regenerated on every start.
configs/generated/

# Local model/reference checkouts
diffusion-pipe-mageflow-ft/
mage-flow/
!configs/mageflow-*.toml

# Local dataset subset and benchmark outputs
benchmarks/kuse-lora/

benchmarks/readme-vram/

# Remote training: per-job configs and logs on the GPU box, and the GUI's saved connect link
# (it carries the server's access token).
remote_jobs/
configs/remote/
.gui_remote.json
# Local experiments, downloaded weights/packages, and reference archives.
benchmarks/
models/
flux3/
the-trainer-copy/
the-trainer-copy.zip
testD_vpred.log
klein-4b-config.json
cache-instant-nl-2gpu.py
# Public experimental template; keep the local machine-specific finetune config private.
!configs/flux3-locon-experimental.toml
/configs/mageflow-finetune.toml

!configs/flux3-finetune-experimental.toml

# Local MOSS weights and upstream reference checkout
/moss-image/
/MOSS-Image/
/KohakuMossTrainer/
/lora_alpha_edit.py
# Local experiments and downloaded model repository.
/moss.toml
/nihilog.txt
/sft/
